---
// @src/components/organisms/TestimonialsSection.astro
import type { CollectionEntry } from "astro:content";

interface Props {
  testimonials: CollectionEntry<"testimonials">[];
  sectionData?: {
    title?: string;
    subtitle?: string;
  };
}

const { testimonials, sectionData } = Astro.props;
const sortedTestimonials = testimonials.sort(
  (a, b) => a.data.order - b.data.order,
);

const title = sectionData?.title || "Lo Que Dicen Nuestros Socios";

import { mdToHtml } from "../../utils/markdown";

const processedTestimonials = await Promise.all(
  sortedTestimonials.map(async (item) => ({
    ...item,
    renderedContent: await mdToHtml(item.data.content),
  })),
);
---

<section id="testimonials" class="py-20 section-gradient">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-5xl font-heading font-bold text-white mb-4">
        <Fragment set:html={await mdToHtml(title)} />
      </h2>
    </div>

    {/* CONTENEDOR PRINCIPAL CON FLECHAS LATERALES */}
    <div class="relative flex items-center justify-center gap-4 lg:gap-12">
      {/* BOTÓN PREV - IZQUIERDA */}
      <button
        id="prev-btn"
        class="hidden md:flex p-3 rounded-full bg-surface border border-white/10 hover:bg-primary/20 text-white z-20 btn-neon-glow group"
        aria-label="Anterior"
      >
        <span class="text-2xl group-hover:-translate-x-1 transition-transform"
          >&larr;</span
        >
      </button>

      {/* SLIDER WINDOW */}
      <div
        class="relative w-full md:w-[85%] lg:w-[80%] min-h-[400px] md:min-h-[350px]"
      >
        {
          processedTestimonials.map((item, index) => (
            <div
              class={`testimonio-slide absolute inset-0 transition-opacity duration-700 flex items-center justify-center ${index === 0 ? "opacity-100 z-10" : "opacity-0 z-0 pointer-events-none"}`}
              data-index={index}
            >
              <div class="glass-card w-full h-full flex flex-col justify-center p-8 md:p-16 rounded-3xl relative mx-auto border border-white/5">
                <span class="absolute top-6 right-8 text-8xl text-primary/10 font-serif leading-none select-none">
                  "
                </span>

                <div class="relative z-10 flex flex-col items-center">
                  <div class="text-gray-300 italic mb-10 leading-relaxed text-xl md:text-2xl text-center max-w-4xl mx-auto [&_p]:inline [&_p]:m-0">
                    <Fragment set:html={item.renderedContent} />
                  </div>

                  <div class="flex flex-col items-center gap-3">
                    <div class="w-16 h-16 rounded-full bg-linear-to-br from-primary to-secondary flex items-center justify-center text-white font-bold text-2xl mb-2 shadow-lg border border-white/10">
                      {item.data.author.charAt(0)}
                    </div>
                    <div class="text-center">
                      <h4 class="text-white font-bold text-lg tracking-wide">
                        {item.data.author}
                      </h4>
                      {item.data.role && (
                        <p class="text-gray-300 text-base font-medium tracking-wide">
                          {item.data.role}
                        </p>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {/* BOTÓN NEXT - DERECHA */}
      <button
        id="next-btn"
        class="hidden md:flex p-3 rounded-full bg-surface border border-white/10 hover:bg-primary/20 text-white z-20 btn-neon-glow group"
        aria-label="Siguiente"
      >
        <span class="text-2xl group-hover:translate-x-1 transition-transform"
          >&rarr;</span
        >
      </button>
    </div>

    {
      /* NAVEGACIÓN MÓVIL (Solo visible en pantallas pequeñas debajo de la card) */
    }
    <div class="flex md:hidden justify-center items-center gap-8 mt-8">
      <button
        id="prev-btn-mobile"
        class="p-3 rounded-full bg-surface border border-white/10 hover:bg-primary/20 text-white transition-all"
      >
        &larr;
      </button>
      <button
        id="next-btn-mobile"
        class="p-3 rounded-full bg-surface border border-white/10 hover:bg-primary/20 text-white transition-all"
      >
        &rarr;
      </button>
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    initSlider();
  });

  // Fallback por si no hay ViewTransitions
  if (document.readyState === "complete") {
    initSlider();
  } else {
    document.addEventListener("DOMContentLoaded", initSlider);
  }

  function initSlider() {
    const slides = document.querySelectorAll(".testimonio-slide");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");
    const prevBtnMobile = document.getElementById("prev-btn-mobile");
    const nextBtnMobile = document.getElementById("next-btn-mobile");

    if (!slides.length) return;

    let currentIndex = 0;
    const totalSlides = slides.length;
    let interval: any;

    function showSlide(index: number) {
      if (index >= totalSlides) currentIndex = 0;
      else if (index < 0) currentIndex = totalSlides - 1;
      else currentIndex = index;

      // Update Slides
      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.remove("opacity-0", "pointer-events-none", "z-0");
          slide.classList.add("opacity-100", "z-10");
        } else {
          slide.classList.remove("opacity-100", "z-10");
          slide.classList.add("opacity-0", "pointer-events-none", "z-0");
        }
      });
    }

    function nextSlide() {
      showSlide(currentIndex + 1);
    }

    function prevSlide() {
      showSlide(currentIndex - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      interval = setInterval(nextSlide, 8000);
    }

    function stopAutoPlay() {
      if (interval) clearInterval(interval);
    }

    // Event Listeners Desktop
    nextBtn?.addEventListener("click", () => {
      nextSlide();
      startAutoPlay();
    });

    prevBtn?.addEventListener("click", () => {
      prevSlide();
      startAutoPlay();
    });

    // Event Listeners Mobile
    nextBtnMobile?.addEventListener("click", () => {
      nextSlide();
      startAutoPlay();
    });

    prevBtnMobile?.addEventListener("click", () => {
      prevSlide();
      startAutoPlay();
    });

    // Iniciar
    startAutoPlay();
  }
</script>
