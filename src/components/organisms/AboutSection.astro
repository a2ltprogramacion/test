---
// @src/components/organisms/AboutSection.astro
import { Image } from "astro:assets";
import { mdToHtml } from "../../utils/markdown";

interface Props {
  data: {
    title: string;
    business_bio: string;
    image?: any;
    image_alt?: string;
    stat_1?: string;
    stat_1_label?: string;
    stat_2?: string;
    stat_2_label?: string;
  };
}

const { data } = Astro.props;
---

<section id="nosotros" class="py-24 bg-surface/30 section-gradient">
  <div
    class="container mx-auto px-6 flex flex-col md:flex-row gap-8 lg:gap-16 items-center max-w-7xl"
  >
    {/* CONTENEDOR DE IMAGEN (Lado Izquierdo) */}
    <div
      class="w-full md:w-1/2 flex justify-center md:justify-end relative group"
    >
      {/* Efecto de resplandor (Blur) detrás */}
      <div
        class="absolute inset-0 bg-linear-to-r from-primary to-secondary rounded-2xl blur-xl opacity-20 group-hover:opacity-30 transition duration-1000 transform scale-95"
      >
      </div>

      {/* Wrapper de la imagen con límites de altura/ancho */}
      <div
        class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-surface/50 w-full max-w-[500px]"
      >
        {
          data.image && (
            <Image
              src={data.image}
              alt={data.image_alt || "Imagen corporativa"}
              class="w-full h-auto max-h-[500px] lg:max-h-[600px] object-cover"
            />
          )
        }
      </div>
    </div>

    {/* CONTENIDO TEXTO (Lado Derecho) */}
    <div class="w-full md:w-1/2 text-center md:text-left">
      <h2 class="text-3xl lg:text-5xl font-heading font-bold text-white mb-6">
        <Fragment set:html={await mdToHtml(data.title)} />
      </h2>

      <div
        class="prose prose-invert prose-lg text-gray-400 mb-8 leading-relaxed"
      >
        <div set:html={await mdToHtml(data.business_bio)} />
      </div>

      <div class="grid grid-cols-2 gap-8 border-t border-white/10 pt-8">
        {
          data.stat_1 && (
            <div>
              <span class="block text-4xl font-bold text-secondary mb-1 bg-clip-text bg-linear-to-r from-white to-gray-400 animate-shine">
                {data.stat_1}
              </span>
              <span class="text-sm text-gray-500 uppercase tracking-widest font-semibold">
                {data.stat_1_label || "Experiencia"}
              </span>
            </div>
          )
        }
        {
          data.stat_2 && (
            <div>
              <span class="block text-4xl font-bold text-secondary mb-1 bg-clip-text bg-linear-to-r from-white to-gray-400 animate-shine">
                {data.stat_2}
              </span>
              <span class="text-sm text-gray-500 uppercase tracking-widest font-semibold">
                {data.stat_2_label || "Confianza"}
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
