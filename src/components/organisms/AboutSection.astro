---
import { Image } from "astro:assets";

interface Props {
  data: {
    title: string;
    business_bio: string;
    image?: any;
    image_alt?: string; // Nuevo campo
    stat_1?: string;
    stat_1_label?: string; // Nuevo
    stat_2?: string;
    stat_2_label?: string; // Nuevo
  };
}

import { mdToHtml } from "../../utils/markdown";

const { data } = Astro.props;
---

<section id="nosotros" class="py-24 bg-surface/30 section-gradient">
  <div
    class="container mx-auto px-6 flex flex-col md:flex-row gap-8 lg:gap-12 items-center max-w-7xl"
  >
    <div class="relative group w-fit mx-auto lg:mx-0 align-center">
      <div
        class="absolute -inset-1 bg-linear-to-r from-primary to-secondary rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-1000"
      >
      </div>

      <div
        class="relative rounded-2xl overflow-hidden border border-white/10 w-fit"
      >
        {
          data.image && (
            <Image
              src={data.image}
              alt={data.image_alt || "Imagen corporativa"}
              width={800}
              height={1000}
              class="w-full h-auto object-cover rounded-2xl"
            />
          )
        }
      </div>
    </div>

    <div class="flex-1 text-center md:text-left">
      <h2 class="text-3xl lg:text-5xl font-heading font-bold text-white mb-6">
        <Fragment set:html={await mdToHtml(data.title)} />
      </h2>
      <div class="prose prose-invert prose-lg text-gray-400 mb-8">
        <div set:html={await mdToHtml(data.business_bio)} />
      </div>

      <div class="grid grid-cols-2 gap-8 border-t border-white/10 pt-8">
        {
          data.stat_1 && (
            <div>
              <span class="block text-3xl font-bold text-secondary mb-1 text-platinum-gradient animate-shine">
                {data.stat_1}
              </span>
              <br />
              <span class="text-sm text-gray-500 uppercase tracking-wider">
                {data.stat_1_label || "Experiencia"}
              </span>
            </div>
          )
        }
        {
          data.stat_2 && (
            <div>
              <span class="block text-3xl font-bold text-secondary mb-1 text-platinum-gradient animate-shine">
                {data.stat_2}
              </span>
              <br />
              <span class="text-sm text-gray-500 uppercase tracking-wider">
                {data.stat_2_label || "Confianza"}
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
