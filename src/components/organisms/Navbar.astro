---
// @src/components/organisms/Navbar.astro
interface Props {
  siteName: string;
  whatsappLink: string;
}

import { getEntry } from "astro:content";

interface Props {
  siteName: string;
  whatsappLink: string;
  modules?: {
    show_hero: boolean;
    show_services: boolean;
    show_knowledge: boolean;
    show_clients: boolean;
    show_testimonials: boolean;
    show_about: boolean;
    show_faq: boolean;
  };
}

const { siteName, whatsappLink, modules } = Astro.props;

// 1. Obtener navegación desde CMS
const navSettings = await getEntry("settings", "navigation");
const customLinks = navSettings?.data?.links;
const actionButton = navSettings?.data?.action_button;

// Fallback si no hay links configurados
const defaultLinks = [
  { label: "Inicio", section_id: "hero", is_external: false },
  { label: "Servicios", section_id: "servicios", is_external: false },
  { label: "Consultorías", section_id: "knowledge", is_external: false },
  { label: "Nosotros", section_id: "nosotros", is_external: false },
  { label: "FAQ", section_id: "faq", is_external: false },
];

// Lógica de Fusión (Smart Merge)
let linksToRender = [...defaultLinks];

if (customLinks && customLinks.length > 0) {
  customLinks.forEach((link: any) => {
    // Si el ID existe en los defaults, actualizamos (ej: cambiar nombre)
    const index = linksToRender.findIndex(
      (defaultLink) => defaultLink.section_id === link.section_id,
    );

    if (index !== -1) {
      linksToRender[index] = { ...linksToRender[index], ...link };
    } else {
      // Si es nuevo (ej: enlace externo), lo agregamos al final
      linksToRender.push(link);
    }
  });
}

// 2. Filtrar enlaces según visibilidad (Feature Flagging)
const activeLinks = linksToRender
  .filter((link: any) => {
    // Si es externo, siempre se muestra
    if (link.is_external) return true;

    // Si no hay configuración de módulos, todo se muestra
    if (!modules) return true;

    // Mapa de visibilidad
    const visibilityMap: Record<string, keyof typeof modules> = {
      hero: "show_hero",
      servicios: "show_services",
      knowledge: "show_knowledge",
      nosotros: "show_about",
      clients: "show_clients",
      faq: "show_faq",
      testimonials: "show_testimonials",
      contact: "show_hero", // Contacto visible si el Hero (Home) está visible
    };

    // Excepción: Si es 'contact', siempre pasa (el footer es global)
    if (link.section_id === "contact") return true;

    const flagKey = visibilityMap[link.section_id];
    return flagKey ? modules[flagKey] : true;
  })
  .map((link: any) => ({
    name: link.label,
    href:
      link.is_external || link.external_url
        ? link.external_url || "#"
        : `/#${link.section_id}`, // Construcción dinámica simple
  }));

// Lógica del Botón de Acción
const actionLabel = actionButton?.label || "WhatsApp";
const finalActionLink =
  actionButton?.use_whatsapp || !actionButton?.url
    ? whatsappLink
    : actionButton?.url;

// Decidir estilo: Botón completo si es personalizado, Icono si es "WhatsApp" por defecto
const isCustomAction = actionLabel.trim().toLowerCase() !== "whatsapp";
const showActionButton = !modules || modules.show_hero; // Vinculado a visibilidad general (Hero/Contact)
---

<header
  id="main-header"
  class="fixed top-0 w-full z-50 transition-all duration-300 border-b border-transparent"
>
  <div class="absolute inset-0 bg-background/80 backdrop-blur-md -z-10"></div>

  <div class="container mx-auto px-6 h-24 flex items-center justify-between">
    {/* LOGO DEL SITIO */}
    <a
      href="/"
      class="text-2xl font-heading font-black text-white tracking-tight hover:text-primary transition-colors"
    >
      {siteName}
      <span class="text-primary">.</span>
    </a>

    {/* MENÚ DE ESCRITORIO */}
    <nav class="hidden md:flex items-center gap-8">
      {
        activeLinks.map((link: any) => (
          <a
            href={link.href}
            class="text-base font-medium text-gray-300 hover:text-white transition-colors relative group"
            target={link.href.startsWith("http") ? "_blank" : "_self"}
          >
            {link.name}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary transition-all group-hover:w-full" />
          </a>
        ))
      }

      {/* BOTÓN DE ACCIÓN (Dinámico) */}
      {
        showActionButton &&
          (isCustomAction ? (
            <a
              href={finalActionLink}
              target="_blank"
              class="ml-4 bg-accent hover:bg-accent/90 text-white px-6 py-2 rounded-full font-bold transition-all hover:scale-105 shadow-[0_0_15px_rgba(249,115,22,0.4)] text-sm uppercase tracking-wider"
            >
              {actionLabel}
            </a>
          ) : (
            <a
              href={finalActionLink}
              target="_blank"
              aria-label={actionLabel}
              class="ml-1 text-gray-400 transition-all duration-300 transform hover:scale-110 hover:text-[#25D366] hover:drop-shadow-[0_0_10px_rgba(37,211,102,0.8)]"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="35"
                height="35"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.894 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.89-5.451 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01s-.521.074-.792.372c-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.289.173-1.413z" />
              </svg>
            </a>
          ))
      }
    </nav>

    {/* BOTÓN MENU MOVIL */}
    <button
      id="menu-toggle"
      class="md:hidden text-white p-2 focus:outline-none"
      aria-label="Abrir menú"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path></svg
      >
    </button>
  </div>

  {/* MENÚ MÓVIL (Sin cambios) */}
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-background/95 backdrop-blur-xl z-40 transform translate-x-full transition-transform duration-300 md:hidden flex flex-col items-center justify-center space-y-8"
  >
    <button
      id="menu-close"
      class="absolute top-6 right-6 text-gray-400 hover:text-white"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </button>

    {
      activeLinks.map((link: any) => (
        <a
          href={link.href}
          class="mobile-link text-2xl font-heading font-bold text-white hover:text-primary"
          target={link.href.startsWith("http") ? "_blank" : "_self"}
        >
          {link.name}
        </a>
      ))
    }

    <a
      href={whatsappLink}
      target="_blank"
      class="mt-4 bg-[#25D366] text-white px-8 py-3 rounded-full font-bold text-lg flex items-center gap-2 shadow-[0_0_20px_rgba(37,211,102,0.4)]"
    >
      <span>WhatsApp</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="currentColor"
        ><path
          d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.894 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.89-5.451 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01s-.521.074-.792.372c-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.289.173-1.413z"
        ></path></svg
      >
    </a>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 bg-background/95 backdrop-blur-xl z-40 transform translate-x-full transition-transform duration-300 md:hidden flex flex-col items-center justify-center space-y-8"
>
  {/* ... (resto del menú móvil igual que antes) ... */}
  <button
    id="menu-close"
    class="absolute top-6 right-6 text-gray-400 hover:text-white"
  >
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"></path></svg
    >
  </button>

  {
    activeLinks.map((link: any) => (
      <a
        href={link.href}
        class="mobile-link text-2xl font-heading font-bold text-white hover:text-primary"
      >
        {link.name}
      </a>
    ))
  }

  {
    showActionButton && (
      <a
        href={finalActionLink}
        target="_blank"
        class={`mt-4 text-white px-8 py-3 rounded-full font-bold text-lg flex items-center gap-2 transition-all ${
          isCustomAction
            ? "bg-accent hover:bg-accent/90 shadow-[0_0_15px_rgba(249,115,22,0.4)]"
            : "bg-[#25D366] shadow-[0_0_20px_rgba(37,211,102,0.4)]"
        }`}
      >
        <span>{actionLabel}</span>
        {!isCustomAction && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.894 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.89-5.451 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01s-.521.074-.792.372c-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.289.173-1.413z" />
          </svg>
        )}
      </a>
    )
  }
</div>

<script>
  // ... (El script se mantiene exactamente igual) ...
  const menuToggle = document.getElementById("menu-toggle");
  const menuClose = document.getElementById("menu-close");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-link");
  const header = document.getElementById("main-header");

  function toggleMenu() {
    mobileMenu?.classList.toggle("translate-x-full");
    document.body.classList.toggle("overflow-hidden");
  }

  menuToggle?.addEventListener("click", toggleMenu);
  menuClose?.addEventListener("click", toggleMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener("click", toggleMenu);
  });

  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      header?.classList.add("border-white/10", "bg-background/90");
    } else {
      header?.classList.remove("border-white/10", "bg-background/90");
    }
  });
</script>
