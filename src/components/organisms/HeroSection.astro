---
// @src/components/organisms/HeroSection.astro
import { Image } from "astro:assets";

interface Props {
  data: {
    // Nuevos campos de control de fondo
    bg_variant: "image" | "color";
    bg_color?: string;

    // Campos de contenido
    image?: any;
    image_alt?: string;
    title: string;
    subtitle?: string;
    cta_text: string;
    cta_link: string;
  };
}

import { mdToHtml } from "../../utils/markdown";

// ... existing imports ...

// ... Props ...

const { data } = Astro.props;

// Lógica de visualización:
const showImage = data.bg_variant === "image" && data.image;
const solidColor = data.bg_color || "#020617"; // Fallback oscuro
---

<section
  id="hero"
  class="relative h-screen flex items-center justify-center overflow-hidden"
  style={data.bg_variant === "color" ? `background-color: ${solidColor};` : ""}
>
  {/* CAPA DE FONDO: IMAGEN (Renderizado Condicional) */}
  {
    showImage && (
      <div class="absolute inset-0 z-0">
        <Image
          src={data.image}
          alt={data.image_alt || "Fondo del Hero"}
          class="w-full h-full object-cover opacity-99"
          loading="eager"
        />
        {/* --- CAMBIO 1: EFECTO TELA VERDE (Overlay) --- */}
        {/* Usamos el Primary con mezcla para oscurecer */}
        <div class="absolute inset-0 bg-primary/90 mix-blend-multiply" />

        {/* NUEVO: Interactive Neon Glow central */}
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--color-neon-glow)_0%,transparent_60%)] opacity-40 mix-blend-screen pointer-events-none" />
      </div>
    )
  }

  {/* CONTENIDO (Siempre visible) */}
  <div class="container mx-auto px-6 relative z-10 text-center">
    {/* Título: Agregado [&_strong]:text-secondary para negrillas amarillas */}
    <h1
      class="text-5xl md:text-7xl font-heading font-bold mb-6 tracking-tight text-secondary text-platinum-gradient animate-shine [&_p]:inline [&_p]:m-0"
    >
      {/* Fragment permite renderizar HTML/Markdown básico si viene del CMS */}
      <Fragment set:html={await mdToHtml(data.title)} />
    </h1>

    {
      data.subtitle && (
        /* Subtítulo: Agregado [&_strong]:text-secondary */
        <div class="text-xl md:text-2xl text-white mb-10 max-w-4xl mx-auto font-light [&_strong]:text-secondary [&_p]:inline [&_p]:m-0">
          <Fragment set:html={await mdToHtml(data.subtitle)} />
        </div>
      )
    }

    {/* --- CAMBIO 2: BOTÓN PLATINUM/NEON --- */}
    <a
      href={data.cta_link}
      class="inline-block bg-[#F8FAFC] text-primary font-bold py-4 px-8 rounded-full btn-neon-glow border border-transparent reveal"
    >
      {data.cta_text}
    </a>
  </div>
</section>
